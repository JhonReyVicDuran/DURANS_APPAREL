{% extends 'base.html.twig' %}

{% block title %}About Us | DURAN'S Apparel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/about.css') }}">
{% endblock %}

{% block body %}

<main class="about-page">

    <!-- ABOUT HERO -->
    <section class="about-hero">

        <div class="about-hero-content">

            <h1>
                About <span>DURAN'S Apparel</span>
            </h1>

            <p>
                DURAN'S Apparel is a clothing brand created for people
                who want to look good, feel comfortable, and walk with confidence.
            </p>

        </div>

    </section>


    <!-- ABOUT CONTENT -->
    <section class="about-content">

        <!-- WHAT IS DURAN'S APPAREL -->
        <div class="about-section">

            <h2>What is DURAN'S Apparel</h2>

            <p>
                DURAN'S Apparel is a modern clothing brand focused on
                creating simple, stylish, and comfortable pieces for
                everyday wear. We believe that clothing is more than
                just something you wear. It is a way to show your
                personality, confidence, and individuality.
            </p>

            <br>

            <p>
                Our collections are designed with a clean and modern
                style while keeping comfort and quality in mind.
                From shirts and hoodies to shorts, caps, and
                compression wear, DURAN'S Apparel aims to provide
                clothing that fits different lifestyles.
            </p>

        </div>


        <!-- MISSION AND VISION -->
        <div class="about-section">

            <h2>Our Mission &amp; Vision</h2>

            <div class="about-boxes">

                <div class="about-box">

                    <h3>Mission</h3>

                    <p>
                        To provide stylish and comfortable apparel
                        that allows people to express themselves
                        with confidence while maintaining quality
                        and affordability.
                    </p>

                </div>

                <div class="about-box">

                    <h3>Vision</h3>

                    <p>
                        To become a trusted clothing brand known for
                        modern designs, quality products, and clothing
                        that inspires confidence in every person.
                    </p>

                </div>

            </div>

        </div>


        <!-- WHAT WE STAND FOR -->
        <div class="about-section">

            <h2>What We Stand For</h2>

            <div class="values">

                <div class="value-card">

                    <h3>Quality</h3>

                    <p>
                        We aim to provide clothing that is comfortable,
                        durable, and made for everyday use.
                    </p>

                </div>

                <div class="value-card">

                    <h3>Style</h3>

                    <p>
                        We create simple and modern designs that can
                        match different personalities and lifestyles.
                    </p>

                </div>

                <div class="value-card">

                    <h3>Confidence</h3>

                    <p>
                        We want our customers to feel comfortable and
                        confident whenever they wear DURAN'S Apparel.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- FIND YOUR STYLE -->
    <section class="about-cta">

        <h2>FIND YOUR STYLE</h2>

        <p>
            Explore our latest collection and find something
            that you might like.
        </p>

        <a href="{{ path('collections') }}">
            SHOP COLLECTION
        </a>

    </section>

</main>

{% endblock %}