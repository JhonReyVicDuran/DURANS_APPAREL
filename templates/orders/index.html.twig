{% extends 'admin_base.html.twig' %}

{% block title %}Orders | DURAN'S Apparel Admin{% endblock %}

{% block body %}

<div class="admin-layout">

    {% include 'partials/sidebar.html.twig' %}

    <main class="main-content orders-page">

        <div class="section-heading">
            <h2>ORDERS</h2>
            <p>Monitor and update customer orders</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="orders-panel">

            <div class="orders-table-wrapper">

                <table class="orders-table">

                    <colgroup>
                        <col class="col-order">
                        <col class="col-customer">
                        <col class="col-contact">
                        <col class="col-address">
                        <col class="col-total">
                        <col class="col-status">
                        <col class="col-date">
                    </colgroup>

                    <thead>
                        <tr>
                            <th>ORDER</th>
                            <th>CUSTOMER</th>
                            <th>CONTACT</th>
                            <th>ADDRESS</th>
                            <th>TOTAL</th>
                            <th>STATUS</th>
                            <th>DATE</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for order in orders %}

                            <tr>
                                <td class="order-number">
                                    <strong>#{{ order.orderNumber }}</strong>

                                    <details>
                                        <summary>View Items</summary>

                                        <div class="order-items-details">
                                            {% for item in order.items %}
                                                <div>
                                                    <strong>{{ item.productName }}</strong>
                                                    <small>
                                                        Size: {{ item.size }} |
                                                        Quantity: {{ item.quantity }} |
                                                        ₱{{ item.unitPrice|number_format(2, '.', ',') }}
                                                    </small>
                                                </div>
                                            {% else %}
                                                <small>No items found.</small>
                                            {% endfor %}
                                        </div>
                                    </details>
                                </td>

                                <td class="customer-info">
                                    <strong>{{ order.customerName }}</strong>
                                    <small>{{ order.email }}</small>
                                </td>

                                <td class="order-contact">
                                    {{ order.phone }}
                                </td>

                                <td class="order-address">
                                    {{ order.address }}
                                </td>

                                <td class="order-total">
                                    ₱{{ order.totalAmount|number_format(2, '.', ',') }}
                                </td>

                                <td>
                                    <form
                                        method="POST"
                                        action="{{ path('admin_orders') }}"
                                        class="status-form"
                                    >
                                        <input
                                            type="hidden"
                                            name="order_id"
                                            value="{{ order.id }}"
                                        >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('update_order_status_' ~ order.id) }}"
                                        >

                                        <select
                                            name="status"
                                            class="status-select status-{{ order.status|lower }}"
                                            onchange="this.form.submit()"
                                        >
                                            {% for status in statuses %}
                                                <option
                                                    value="{{ status }}"
                                                    {% if order.status == status %}selected{% endif %}
                                                >
                                                    {{ status }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                </td>

                                <td class="order-date">
                                    {{ order.createdAt|date('Y-m-d H:i:s') }}
                                </td>
                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="7" class="no-orders">
                                    No orders available.
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

{% endblock %}