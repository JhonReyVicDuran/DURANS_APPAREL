<header class="navbar">

    <!-- LOGO -->
    <div class="logo">
        <a href="{{ path('app_home') }}">
            <img
                src="{{ asset('admin/images/logo.png') }}"
                alt="DURAN'S Logo"
            >
        </a>
    </div>

    <!-- NAVIGATION MENU -->
    <nav class="menu">

        <a href="{{ path('app_home') }}"
           class="{{ app.request.pathInfo == '/home' ? 'active' : '' }}">
            HOME
        </a>

        <a href="{{ path('about') }}"
           class="{{ app.request.pathInfo == '/about' ? 'active' : '' }}">
            ABOUT US
        </a>

        <a href="{{ path('collections') }}"
           class="{{ app.request.pathInfo == '/collections' ? 'active' : '' }}">
            COLLECTIONS
        </a>

        <a href="{{ path('contact') }}"
           class="{{ app.request.attributes.get('_route') == 'contact' ? 'active' : '' }}">
            CONTACT US
        </a>

    </nav>

    <!-- ACCOUNT SECTION -->
    <div class="account">

        {% if app.user %}

            {% if is_granted('ROLE_ADMIN') %}

                <a href="{{ path('admin_dashboard') }}" class="login">
                    ADMIN DASHBOARD
                </a>

            {% else %}

                <span class="user-name">
                    Hello, {{ app.user.fullName }}
                </span>

            {% endif %}

            <a
                href="{{ path('app_logout') }}"
                class="login"
                onclick="openLogoutPopup(event);"
            >
                Log Out
            </a>

        {% else %}

            <a href="{{ path('login') }}" class="login">
                Log in
            </a>

            <a href="{{ path('signup') }}" class="signup-nav-btn">
                Sign Up
            </a>

        {% endif %}

        <!-- SHOPPING CART -->
        <a href="{{ path('cart') }}">
            🛒
        </a>

    </div>

</header>