<header class="navbar">

    <div class="logo">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('images/logo.png') }}"
                 alt="DURAN'S Logo">
        </a>
    </div>

    <nav class="menu">

        
<nav class="menu">

    
<nav class="menu">

    <a href="/home"
       class="{{ app.request.pathInfo == '/home' ? 'active' : '' }}">
        HOME
    </a>

    <a href="{{ path('about') }}"
       class="{{ app.request.pathInfo == '/about' ? 'active' : '' }}">
        ABOUT US
    </a>

    
    <a href="{{ path('collections') }}"
        class="{{ app.request.pathInfo == '/collections' ? 'active' : '' }}">
        COLLECTIONS
    </a>


    <a href="{{ path('contact') }}"
        class="{{ app.request.attributes.get('_route') == 'contact' ? 'active' : '' }}">
        CONTACT US
    </a>

</nav>


</nav>


    </nav>

    <div class="account">

        {% if app.session.get('user_id') %}

            <span class="user-name">
                Hello, {{ app.session.get('full_name')|e }}
            </span>

            <a href="{{ path('app_logout') }}"
               class="login"
               onclick="openLogoutPopup(event);">
                Log Out
            </a>

        {% else %}

            <a href="/login" class="login">Log in</a>

            <a href="{{ path('signup') }}" class="signup-nav-btn">
                Sign Up
            </a>

        {% endif %}

        <a href="{{ path('cart') }}">
            🛒
        </a>

    </div>

</header>