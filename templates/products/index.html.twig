{% extends 'admin_base.html.twig' %}

{% block title %}Products - DURAN'S Apparel{% endblock %}

{% block body %}

<section class="content-section">

    <div class="section-heading">
        <h2>PRODUCTS</h2>
        <p>Manage products</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="success-message">
            {{ message }}
        </div>
    {% endfor %}

    {% if error %}
        <div class="error-message">
            {{ error }}
        </div>
    {% endif %}

    <!-- ADD PRODUCT FORM -->
    <div class="product-panel">

        <h3>ADD NEW PRODUCT</h3>

        <form method="POST" action="{{ path('admin_products') }}">

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('add_product') }}"
            >

            <div class="form-row">

                <div class="form-group">
                    <label>Product Name</label>

                    <input
                        type="text"
                        name="product_name"
                        placeholder="Example: Classic Hoodie"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Category</label>

                    <select name="category_id" required>
                        <option value="">Select Category</option>

                        {% for category in categories %}
                            <option value="{{ category.id }}">
                                {{ category.categoryname }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Price (₱)</label>

                    <input
                        type="number"
                        name="price"
                        placeholder="0.00"
                        min="0"
                        step="0.01"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Stock</label>

                    <input
                        type="number"
                        name="stock"
                        placeholder="0"
                        min="0"
                        step="1"
                        required
                    >
                </div>

            </div>

            <div class="form-group full-width">

                <label>Available Sizes</label>

                <select
                    name="sizes[]"
                    multiple
                    required
                    style="min-height: 130px;"
                >
                    {% for size in availableSizes %}
                        <option value="{{ size }}">
                            {{ size }}
                        </option>
                    {% endfor %}
                </select>

                <small>
                    Hold CTRL and click to select multiple sizes.
                </small>

            </div>

            <div class="form-group full-width">

                <label>Description</label>

                <textarea
                    name="description"
                    rows="5"
                    placeholder="Product description"
                    required
                ></textarea>

            </div>

            <div class="form-actions">

                <button
                    type="submit"
                    class="add-product-btn"
                >
                    Add Product
                </button>

            </div>

        </form>

    </div>

    <!-- PRODUCT LIST -->
    <div class="product-panel">

        <h3>PRODUCT LIST</h3>

        {% if products is empty %}

            <p>No products have been added yet.</p>

        {% else %}

            <div class="table-responsive">

                <table class="product-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Sizes</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for product in products %}

                            <tr>
                                <td>{{ product.id }}</td>

                                <td>{{ product.productName }}</td>

                                <td>
                                    {{ product.category.categoryname }}
                                </td>

                                <td>
                                    ₱{{ product.price }}
                                </td>

                                <td>{{ product.stock }}</td>

                                <td>
                                    {{ product.sizes|default([])|join(', ') }}
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        {% endif %}

    </div>

</section>

{% endblock %}
